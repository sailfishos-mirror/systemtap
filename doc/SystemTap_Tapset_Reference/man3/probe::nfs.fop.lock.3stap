.SH "NAME"
probe::nfs.fop.lock \- NFS client file lock operation
.SH "SYNOPSIS"
.sp
.nf
probe nfs\&.fop\&.lock {}
.fi
.SH "VALUES"
.PP
\fIi_mode\fR
.RS 4
file type and access rights
.RE
.PP
\fIino\fR
.RS 4
inode number
.RE
.PP
\fIlock_type\fR
.RS 4
lock type
.RE
.PP
\fIcmd\fR
.RS 4
cmd arguments
.RE
.PP
\fIdev\fR
.RS 4
device identifier
.RE
.PP
\fIlock_flags\fR
.RS 4
lock flags
.RE
.PP
\fIlock_end\fR
.RS 4
ending offset of locked region
.RE
.PP
\fIlock_start\fR
.RS 4
starting offset of locked region
.RE
