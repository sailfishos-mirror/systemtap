.SH "NAME"
probe::nfs.fop.flush \- NFS client flush file operation
.SH "SYNOPSIS"
.sp
.nf
probe nfs\&.fop\&.flush {}
.fi
.SH "VALUES"
.PP
\fIndirty\fR
.RS 4
number of dirty page
.RE
.PP
\fIino\fR
.RS 4
inode number
.RE
.PP
\fImode\fR
.RS 4
file mode
.RE
.PP
\fIdev\fR
.RS 4
device identifier
.RE
