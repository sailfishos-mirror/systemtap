private cve_load_time

# The globals below are the patch's knobs.  How they are reached depends on the
# runtime the script is built for:
#
#   kernel-module: paired procfs read/write handlers, plus the prometheus dump
#                  under /proc/systemtap/MODULE_NAME/
#   bpf:           one handler per procfs path, so write handlers only
#   dyninst:       no procfs or prometheus probe points, so the script sets the
#                  globals itself and reports through its own status line

# The band-aid script may declare global cve_name = "CVE-..." to have the
# load/unload messages and the prometheus metrics carry that label.  The
# declaration belongs to the script; this tapset only references it.

global cve_notify_p  = 1
global cve_fix_p     = 1
global cve_trace_p   = 1
global cve_enabled_p = 1
global cve_tmpdisabled_s = -1

global cve_name

probe begin {
  cve_load_time = gettimeofday_s()

  if (cve_notify_p)
    printf("%s mitigation loaded\n", cve_name)
}

probe end,error {
  if (cve_notify_p)
    printf("%s mitigation unloaded\n", cve_name)
}

# Flag values arriving through procfs.  The bpf runtime has no strtol, so
# there the written text is matched instead of parsed.
function cve_flag:long(value:string) { /* unprivileged */
  if (value == "0" || value == "0\n") return 0
  return 1
}

@define cve_probe_procfs_parameter (glbl, f_name) %(
  probe procfs(@f_name).read
    { $value = sprintf("%d\n", @glbl) }

  probe procfs(@f_name).write
    { @glbl = strtol($value, 10) }
%)

@define cve_probe_procfs_write (glbl, f_name) %(
  probe procfs(@f_name).write
    { @glbl = cve_flag($value) }
%)

# Parameter reading and updating.  The kernel-module runtime gets a read and a
# write handler per knob.  The bpf runtime allows only one kind per path, so it
# gets write handlers.  The dyninst runtime has no procfs probes, and scripts
# for it fix the globals where they are launched.
%( runtime == "kernel" %?
@cve_probe_procfs_parameter(cve_notify_p  , "cve_notify_p")
@cve_probe_procfs_parameter(cve_trace_p   , "cve_trace_p")
@cve_probe_procfs_parameter(cve_fix_p     , "cve_fix_p")
@cve_probe_procfs_parameter(cve_enabled_p , "cve_enabled_p")

probe procfs("cve_tmpdisabled_s").read
  { $value = sprintf("%d\n", cve_tmpdisabled_s) }
probe procfs("cve_tmpdisabled_s").write
{ cve_tmpdisabled_s = strtol($value, 10)
  if (cve_tmpdisabled_s > 0)
    cve_enabled_p = 0  # trigger temporary disable
}
%)

%( runtime == "bpf" %?
@cve_probe_procfs_write(cve_notify_p  , "cve_notify_p")
@cve_probe_procfs_write(cve_trace_p   , "cve_trace_p")
@cve_probe_procfs_write(cve_fix_p     , "cve_fix_p")
@cve_probe_procfs_write(cve_enabled_p , "cve_enabled_p")

probe procfs("cve_tmpdisabled_s").read
  { $value = sprintf("%d\n", cve_tmpdisabled_s) }
# cve_tmpdisable(DURATION) from within the script covers temporary disabling.
%)


# The metric accumulation and prometheus
global cve_metrics

/**
 * sfunction cve_count_metric - Increment the count of key
 *
 * @key: The metric
 *
 * Description: This function increments the count of the metric
 * key by 1. The metrics can be accessed in
 * /proc/systemtap/MODULE_NAME/__prometheus
 */
function cve_count_metric (key:string) {
  cve_metrics[key] ++
}

/**
 * sfunction cve_record_metric - Set the value of key
 *
 * @key: The metric
 * @value: The new value
 *
 * Description: This function sets the value of the metric
 * key. The metrics can be accessed in
 * /proc/systemtap/MODULE_NAME/__prometheus
 */
function cve_record_metric (key:string, value:long) {
  cve_metrics[key] = value
}

# Metrics reporting.  The prometheus dump needs procfs too; elsewhere the
# counters are still visible through the script's own status line.
%( runtime != "dyninst" %?
probe prometheus {
  cve_record_metric("runtime", gettimeofday_s() - cve_load_time)
  @prometheus_dump_array1(cve_metrics, cve_name, "metric")
}
%)

# Disabling the patch
probe timer.s(1) {
  if(!cve_enabled_p && cve_tmpdisabled_s >= 0){
    if(cve_tmpdisabled_s > 0){
      cve_tmpdisabled_s--
    }else{
      if (cve_notify_p)
        printf("%s reenabling\n", cve_name)
      cve_enabled_p = 1
      cve_tmpdisabled_s = -1
    }
  }
}

# Periodic status line, so a long-running band-aid is observable in plain
# staprun output without scraping procfs or prometheus.  The script can add
# its own counters to cve_metrics to have them reported here too.  The bpf
# variant lists the standard metric keys literally, since its timer probes
# run in kernel context where loops are not yet supported (PR24528).
%( runtime != "bpf" %?
probe timer.s(60) {
  if (cve_notify_p) {
    printf("%s status enabled?%d fix?%d", cve_name, cve_enabled_p, cve_fix_p)
    foreach (key+ in cve_metrics)
      printf(" %s#%d", key, cve_metrics[key])
    printf("\n")
  }
}
%:
probe timer.s(60) {
  if (cve_notify_p)
    printf("%s status enabled?%d fix?%d hit#%d miss#%d\n", cve_name,
           cve_enabled_p, cve_fix_p,
           cve_metrics["hit"], cve_metrics["miss"])
}
%)

/**
 * sfunction cve_tmpdisable - Disable the cve livepatch
 *
 * @duration: The number of seconds to disable
 *
 * Description: This function temporarily disables the
 * conditionals which use cve_enabled_p for duration seconds.
 * If duration is -1, disable the livepatch until reenabled.
 */
function cve_tmpdisable(duration:long){
  if (cve_notify_p)
    printf("%s disabling temporarily\n", cve_name)
  cve_enabled_p = 0
  cve_tmpdisabled_s = duration
}
