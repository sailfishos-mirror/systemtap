set test "unprivileged myproc"
if {![installtest_p]} { untested $test; return }
if {![uprobes_p]} { untested $test; return }

set exepath "loop"
set sopath "libloop.so"

# Default: full probe catalog in a few combined stap runs; .exp still
# issues one PASS/FAIL per probe type from FIRE tags in the output.
# Optional smaller catalog for debugging:
#   UNPRIVILEGED_MYPROC_SMOKE=1
set myproc_full 1
if {[info exists env(UNPRIVILEGED_MYPROC_SMOKE)] \
	&& $env(UNPRIVILEGED_MYPROC_SMOKE) != "" \
	&& $env(UNPRIVILEGED_MYPROC_SMOKE) != "0"} {
    set myproc_full 0
}

