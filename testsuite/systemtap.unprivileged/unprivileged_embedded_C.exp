set test "unprivileged embedded C"
set arch [exec uname -m]
# normalize arch; PR4186
set arch [normalize_arch $arch]

# Some functions are only "native" for certain kernel versions.
set kv [exec uname -r | grep -o -G  {^[0-9]\+.[0-9]\+.[0-9]\+}]
set kvbits [split $kv .]
set k1 [lindex $kvbits 0]
set k2 [lindex $kvbits 1]
set k3 [lindex $kvbits 2]
verbose -log "kernel version $k1.$k2.$k3"

# Add arguments to a probe type template.
proc add_args { prototype } {
    set call "$prototype"

    # Replace long with 0
    regsub -all "(\[(,]\[\[:space:]]*)long" $call "\\10" call

    # Replace string with "0"
    regsub -all "(\[(,]\[\[:space:]]*)string" $call "\\1\"0\"" call

    return "$call"
}

# Build the filtered list of {prototype status funcname call} cases.
proc collect_embedded_cases { test_fraction } {
    global prototype_info k1 k2 k3 test

    set cases {}
    set test_num 0
    foreach info $prototype_info {
	set test_num [expr $test_num + 1]

	set tokens [split $info ";"]
	set prototype [lindex $tokens 0]
	set status [lindex $tokens 1]

	if {[expr $test_num % $test_fraction] != 0} {
	    continue
	}

	switch "$prototype" {
	    "probefunc ()" {
		untested "$test: $status: $prototype (rewritten pure)"
		continue
	    }
	}

	switch "$prototype" {
	    "cpuid ()" -
	    "get_mmap_args (long)" {
		untested "$test: $status: $prototype (deprecated)"
		continue
	    }
	}

	if { "$prototype" == "__get_skb_iphdr(long)" } {
	    if {($k1*256*256 + $k2*256 + $k3) < (2*256*256 + 6*256 + 21)} {
		untested "$test: $status: $prototype"
		continue
	    }
	}

	if { $status == "no embedded C" } {
	    continue
	}

	regexp "(\[^\[:space:](]*).*" $prototype match funcname
	set call [add_args $prototype]
	lappend cases [list $prototype $status $funcname $call]
    }
    return $cases
}

# Expect a privilege deny for this status at this privilege level?
proc embedded_expect_deny { status privilege } {
    if {$status == "privileged" && $privilege == "stapusr"} {
	return 1
    }
    return 0
}

# stapusr (and mixed allow/deny) privilege checks: one omnibus script +
# --semantic-keep-going.  Each case is one source line; privilege rejects
# are matched via the SEMANTIC_ERROR catalog (XFAIL when expected).
# --unprivileged and --privilege=stapusr are each run once over the same
# script.  stapsys stays on the per-case path below (expected accept).
proc test_embedded_C_batch { privilege test_fraction { transitive_test 0 } } {
    global test

    set cases [collect_embedded_cases $test_fraction]
    if {[llength $cases] == 0} {
	return
    }

    set tag $privilege
    if {$transitive_test} {
	set tag "$privilege transitive"
    }
    set test "unprivileged embedded C: $tag"

    set stapfile "unpriv_embedded_C_${privilege}"
    if {$transitive_test} {
	append stapfile "_transitive"
    }
    append stapfile ".stp"

    set fh [open $stapfile w]
    set line_no 0
    set batch_meta {}

    foreach case $cases {
	foreach {prototype status funcname call} $case { break }
	incr line_no
	if {$transitive_test} {
	    puts $fh "function __uemb_${line_no}() { $call }"
	    # Privilege error tokens land on the call inside the wrapper.
	    set deny_line $line_no
	    incr line_no
	    puts $fh "probe begin { __uemb_${deny_line}() }"
	} else {
	    puts $fh "probe begin { $call }"
	    set deny_line $line_no
	}
	lappend batch_meta [list $prototype $status $funcname $deny_line \
				[embedded_expect_deny $status $privilege]]
    }
    close $fh

    set options [list]
    switch $privilege {
	stapusr {
	    set options [list --unprivileged --privilege=stapusr]
	}
	stapdev {
	    set options [list "" --privilege=stapdev]
	}
	default {
	    set options [list "--privilege=$privilege"]
	}
    }

	foreach option $options {
	# Empty option (stapdev default) must not leave a hole in the argv.
	# Deliberately omit -u: with unoptimized translation, some
	# embedded-expression privilege checks (e.g. task_current) are
	# skipped in multi-probe keep-going scripts.
	if {$option == ""} {
	    set cmd [list stap --semantic-keep-going -p2 $stapfile]
	} else {
	    set cmd [list stap --semantic-keep-going -p2 $option $stapfile]
	}
	verbose -log "eval exec $cmd"
	# Drop stdout noise; keep stderr (incl. SEMANTIC_ERROR catalog).
	catch {eval exec $cmd >/dev/null} res_stap
	verbose -log $res_stap

	set denied_funcs {}
	foreach outline [split $res_stap "\n"] {
	    # SEMANTIC_ERROR file line col token msg
	    if {[regexp {^SEMANTIC_ERROR\t[^\t]+\t[0-9]+\t[0-9]+\t([^\t]+)\t(.*)$} \
		     $outline -> tok msg]} {
		if {[string match {*may not be used when --privilege=*} $msg]} {
		    if {$tok != "-"} {
			lappend denied_funcs $tok
		    }
		}
	    }
	}

	foreach meta $batch_meta {
	    foreach {prototype status funcname deny_line expect_deny} $meta {
		break
	    }
	    # Privilege errors for embedded-C functions point at the
	    # tapset declaration token (function name), not our call site.
	    set found [expr {[lsearch -exact $denied_funcs $funcname] >= 0}]
	    set name "$test: $status: $option: $prototype (keep-going batch)"
	    if {$expect_deny} {
		if {$found} {
		    xfail $name
		} else {
		    fail "$name (missing deny; funcs={$denied_funcs})"
		}
	    } else {
		if {!$found} {
		    pass $name
		} else {
		    fail "$name (unexpected deny)"
		}
	    }
	}
    }

    catch {file delete $stapfile}
}

# Per-case path (used for stapsys expected-accept coverage).
proc test_embedded_C { privilege test_fraction { transitive_test 0 } } {
    global test

    if {$privilege == "stapusr"} {
	test_embedded_C_batch $privilege $test_fraction $transitive_test
	return
    }

    set cases [collect_embedded_cases $test_fraction]
    set test "unprivileged embedded C: $privilege"
    if {$transitive_test} {
	set test "$test (transitive)"
    }

    set stapdev_options [list "" --privilege=stapdev]
    set selector 0
    foreach case $cases {
	foreach {prototype status funcname call} $case { break }

	switch $privilege {
	    stapdev {
		set option [lindex $stapdev_options $selector]
	    }
	    default {
		set option "--privilege=$privilege"
	    }
	}

	if { $transitive_test } {
	    set cmd [concat [list stap -u -p2 $option -e] \
			 "'function foo() { $call } probe begin { foo() }'"]
	} else {
	    set cmd [concat [list stap -u -p2 $option -e] \
			 "'probe begin { $call }'"]
	}
	if {! [info exists env(SYSTEMTAP_SHOW_EMBEDDED_C)]} {
	    verbose -log "eval exec sh -c $cmd >/dev/null"
	    catch {exec sh -c "$cmd" >/dev/null} res_stap
	} else {
	    verbose -log "eval exec sh -c $cmd"
	    catch {exec sh -c "$cmd"} res_stap
	}
	verbose -log $res_stap

	set emsg1 "semantic error: function may not be used when --privilege=stapusr is specified: identifier '$funcname'"
	set emsg2 "semantic error: embedded expression may not be used when --privilege=stapusr is specified"
	set found [expr {[regexp ".*$emsg1.*" $res_stap] \
			     || [regexp ".*$emsg2.*" $res_stap]}]

	# stapsys/stapdev: never expect a stapusr privilege deny message
	set expect_deny [embedded_expect_deny $status $privilege]
	set name "$test: $status: $option: $prototype"
	if {$expect_deny} {
	    if {$found} {
		xfail $name
	    } else {
		fail $name
	    }
	} else {
	    if {!$found} {
		pass $name
	    } else {
		fail $name
	    }
	}

	set selector [expr ($selector + 1) % 2]
    }
}

# Obtain the prototypes of all tapset functions containing embedded C code.
set tapsetdir "$srcdir/../tapset"
verbose -log "Looking for tapset scripts in $tapsetdir"
set files [glob -nocomplain $tapsetdir/*.stp]
verbose -log "Looking for tapset scripts in $tapsetdir/[exec uname -m]"
set files [concat $files [glob -nocomplain $tapsetdir/[exec uname -m]/*.stp]]
verbose -log "Looking for tapset scripts in $tapsetdir/linux"
set files [glob -nocomplain $tapsetdir/linux/*.stp]
verbose -log "Looking for tapset scripts in $tapsetdir/linux/[exec uname -m]"
set files [concat $files [glob -nocomplain $tapsetdir/linux/[exec uname -m]/*.stp]]

verbose -log "eval exec $srcdir/$subdir/embeddedc.awk [join $files]"
catch {eval exec $srcdir/$subdir/embeddedc.awk [join $files]} res_stap
set prototype_info [split $res_stap "\n"]

verbose -log "prototype_info contains [llength prototype_info] items"
if {[llength prototype_info] > 0} {
    pass "$test: Obtain list tapset functions containing embedded C"
} else {
    fail "$test: Obtain list tapset functions containing embedded C"
    untested "$test"
    return
}

# Now run the tests.
# Wave-4 prune: default samples 1/5 of embedded-C tapset functions for
# both direct and transitive privilege checks. Restore with:
#   UNPRIVILEGED_EMBEDDED_C_FULL=1
# (SYSTEMTAP_TEST_ALL_EMBEDDED_C still forces transitive fraction=1.)
# Wave-4.5: stapusr runs use --semantic-keep-going omnibus batches.
if {[info exists env(UNPRIVILEGED_EMBEDDED_C_FULL)] \
	&& $env(UNPRIVILEGED_EMBEDDED_C_FULL) != "" \
	&& $env(UNPRIVILEGED_EMBEDDED_C_FULL) != "0"} {
    set test_fraction 1
} elseif {[info exists env(SYSTEMTAP_TEST_ALL_EMBEDDED_C)]} {
    set test_fraction 1
} else {
    set test_fraction 5
    verbose -log "$test: Wave-4 smoke (1/$test_fraction of functions; set UNPRIVILEGED_EMBEDDED_C_FULL=1 for full)"
}
test_embedded_C stapusr $test_fraction
test_embedded_C stapsys $test_fraction
#test_embedded_C stapdev $test_fraction

# Transitive privilege: pure wrapper calling the embedded-C function.
set test "$test (transitive)"
test_embedded_C stapusr $test_fraction 1
test_embedded_C stapsys $test_fraction 1
#test_embedded_C stapdev $test_fraction 1
