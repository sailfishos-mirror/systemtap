probe begin
{
    stp_pid = stp_pid()
    printf("%d\n%d begat %d\n", stp_pid, stp_pid, target())
}

# In the below code, why is the following necessary?
#
#	user_long(&@cast($rqtp, "struct timespec")->tv_sec)
#
# Why not just do '$rqtp->tv_sec'?  On s390x and ppc64, because of
# syscall wrappers, req_uaddr gets turned into a long. So, 'req_uaddr->tv_sec'
# won't work everywhere.
#
# Why not do '@cast(req_uaddr, "struct timespec")->tv_sec'? The pointer
# isn't to kernel memory, but to user memory, so we have to read it
# properly.
#
# struct timespec is often absent from kernel DWARF/vmlinux.h on modern
# kernels (y2038); userspace layout matches struct __kernel_timespec
# (see aux_syscalls.stp / STAPCONF_TIME_TYPES_H). Fall back to
# timespec64 if needed. compat_timespec was renamed to old_timespec32.

function _target_set_tv_sec:long(uaddr:long)
{
	if (@defined(@cast(0, "struct timespec", "kernel")->tv_sec))
		return user_long(&@cast(uaddr, "struct timespec", "kernel")->tv_sec)
	if (@defined(@cast(0, "struct __kernel_timespec", "kernel")->tv_sec))
		return user_long(&@cast(uaddr, "struct __kernel_timespec", "kernel")->tv_sec)
	return user_long(&@cast(uaddr, "struct timespec64", "kernel")->tv_sec)
}

function _target_set_compat_tv_sec:long(uaddr:long)
{
	if (@defined(@cast(0, "struct compat_timespec", "kernel")->tv_sec))
		return user_long(&@cast(uaddr, "struct compat_timespec", "kernel")->tv_sec)
	return user_long(&@cast(uaddr, "struct old_timespec32", "kernel")->tv_sec)
}

# Modern coreutils sleep uses clock_nanosleep, not nanosleep.
probe syscall.nanosleep, syscall.clock_nanosleep
{
    if (target_set_pid(pid())
	&& _target_set_tv_sec(req_uaddr) == $1)
	target_set_report()
}
probe syscall.compat_nanosleep ?, syscall.compat_clock_nanosleep ?
{
    if (target_set_pid(pid())
	&& _target_set_compat_tv_sec(req_uaddr) == $1)
	target_set_report()
}

probe end
{
    target_set_report()
}
