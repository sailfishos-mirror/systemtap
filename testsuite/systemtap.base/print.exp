# Wave-3: early language microtest; skip unless BASE_MICROTESTS_FULL=1.
if {[base_microtest_skip_p]} {
    untested "[file rootname [file tail [info script]]] (base microtest; set BASE_MICROTESTS_FULL=1)"
    return
}

# Test that all the print statements work

set test "print"

set output_string "(${all_pass_string}){9}"
foreach runtime [get_runtime_list] {
    if {$runtime != ""} {
	stap_run $test no_load $output_string \
	    --runtime=$runtime $srcdir/$subdir/$test.stp
    } else {
	stap_run $test no_load $output_string $srcdir/$subdir/$test.stp
    }
}
