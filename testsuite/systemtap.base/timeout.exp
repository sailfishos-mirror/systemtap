# Wave-3: early language microtest; skip unless BASE_MICROTESTS_FULL=1.
if {[base_microtest_skip_p]} {
    untested "[file rootname [file tail [info script]]] (base microtest; set BASE_MICROTESTS_FULL=1)"
    return
}

set test "timeout option"
if {![installtest_p]} {untested $test; return}

set success 0
verbose -log "Running stap -T 1 -e \'probe end {println(\"terminated\")}\'"
spawn stap -T 1 -e "probe end {println(\"terminated\")}"
expect {
  -timeout 20
  -re "terminated" {incr success}
}
catch { close }; catch { wait }
if {$success == 1} {pass $test} {fail $test}
