probe process.function("main")
{
  s16 = $utf16_string;
  for (p16 = s16; i = user_short(p16) & 0xffff; p16 += 2)
    printf("%X ", i)
  println(":")
  println(user_string_utf16(s16))
  println(user_string_quoted_utf16(s16))

  s32 = $utf32_string;
  for (p32 = s32; i = user_int(p32) & 0xffffffff; p32 += 4)
    printf("%X ", i)
  println(":")
  println(user_string_utf32(s32))
  println(user_string_quoted_utf32(s32))
}

