// fsnotify() parameter rename: data_is -> data_type (b54cecf5e229, v5.9+).
// FSNOTIFY_EVENT_PATH value comes from DWARF via @enum (shifted when
// 9740d17162de inserted FSNOTIFY_EVENT_FILE_RANGE ahead of it, v6.14+).

probe kernel.function("fsnotify") ?
{
    if (!target_set_pid(pid())) {
	next
    }
    if (@choose_defined($data_is, $data_type) == @enum("FSNOTIFY_EVENT_PATH")) {
        path = task_dentry_path(task_current(), @cast($data, "path")->dentry,
				@cast($data, "path")->mnt);
        println(path);
    }
}

probe begin
{
    printf("begin\n")
}
