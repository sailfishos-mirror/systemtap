# Wave-3: early language microtest; skip unless BASE_MICROTESTS_FULL=1.
if {[base_microtest_skip_p]} {
    untested "[file rootname [file tail [info script]]] (base microtest; set BASE_MICROTESTS_FULL=1)"
    return
}

set test "optionalprobe"
spawn stap -u -p2 -w $srcdir/$subdir/$test.stp
expect {
    -timeout 120
    -re "# probes\r\n" { exp_continue }
    -re "^begin" { pass $test }
    eof { fail $test }
    timeout { fail "$test unexpected timeout" }
}
catch {close}; catch {wait}
