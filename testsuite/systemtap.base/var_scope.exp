# Wave-3: early language microtest; skip unless BASE_MICROTESTS_FULL=1.
if {[base_microtest_skip_p]} {
    untested "[file rootname [file tail [info script]]] (base microtest; set BASE_MICROTESTS_FULL=1)"
    return
}

# Check variables scope

set test "var_scope"
if {![installtest_p]} { untested "$test"; return }

foreach runtime [get_runtime_list] {
    if {$runtime != ""} {
	stap_run $test no_load $all_pass_string \
	    --runtime=$runtime -w $srcdir/$subdir/$test.stp
    } else {
	stap_run $test no_load $all_pass_string \
	    -w $srcdir/$subdir/$test.stp
    }
}
