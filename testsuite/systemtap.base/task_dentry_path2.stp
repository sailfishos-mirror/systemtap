// pipe_read renamed to anon_pipe_read for anonymous pipes
// (f017b0a4951f, v6.15+); keep pipe_read for older kernels.
probe kernel.function("pipe_read") !,
      kernel.function("anon_pipe_read")
{
    t = task_current()
    println(task_dentry_path(t, $iocb->ki_filp->f_path->dentry,
	    $iocb->ki_filp->f_path->mnt))
    exit()
}
