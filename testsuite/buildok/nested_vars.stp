#! stap -gp4

global xargv
global xtext
function f(x) { return x }

probe kernel.function("do_execve") !, kernel.function("__do_sys_execve")
{
  if (@defined($__argv)) {
    xargv = $__argv[$__argv[f(0)][f(1)]][$__argv[f(2)][f(3)]]
    $__argv[$__argv[f(4)][f(5)]][2] = xargv
  } else if (@defined($argv)) {
    xargv = $argv[$argv[f(0)][f(1)]][$argv[f(2)][f(3)]]
    $argv[$argv[f(4)][f(5)]][2] = xargv
  }
}

probe kernel.trace("printk:console") ?
{
  xtext = $text[$text[1]]
  $text[$text[0]] = xtext
}
